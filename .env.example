# DepthWizard reads process environment variables. These values document a
# local configuration; export the ones you need before starting the backend.
DEPTHWIZARD_MODEL_ID=depth-anything/Depth-Anything-V2-Base-hf
DEPTHWIZARD_MAX_INPUT_SIZE=1024
DEPTHWIZARD_MAX_DECODED_PIXELS=50000000
DEPTHWIZARD_ARTIFACT_DIR=backend/artifacts
# Comma-separated exact frontend origins; set this when demonstrating over a LAN.
DEPTHWIZARD_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Optional Hugging Face cache override.
HF_HOME=.cache/huggingface
# HF_HUB_CACHE=.cache/huggingface/hub

# Enable both only after the selected model is present in the cache.
HF_HUB_OFFLINE=0
TRANSFORMERS_OFFLINE=0

# Read by Vite when set in the frontend environment.
VITE_API_URL=http://localhost:8000
